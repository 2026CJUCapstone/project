import std.io;

var reader_buffer: [4096]u8;
var reader_pos: u64 = 0;
var reader_len: u64 = 0;
var grid: [10000]u8;
var distances: [10000]u64;
var queue: [10000]u64;

func next_byte() -> i64 {
    if (reader_pos >= reader_len) {
        var count: i64 = input_read(&reader_buffer[0], 4096);
        if (count <= 0) { return -1; }
        reader_len = (u64)count;
        reader_pos = 0;
    }
    var value: i64 = (i64)reader_buffer[reader_pos];
    reader_pos += 1;
    return value;
}

func next_i64() -> i64 {
    var current: i64 = next_byte();
    while (current >= 0 && current <= 32) { current = next_byte(); }
    var sign: i64 = 1;
    if (current == 45) {
        sign = -1;
        current = next_byte();
    } else if (current == 43) {
        current = next_byte();
    }
    var value: i64 = 0;
    while (current >= 48 && current <= 57) {
        value = value * 10 + (current - 48);
        current = next_byte();
    }
    return value * sign;
}

func next_grid_cell() -> u8 {
    var current: i64 = next_byte();
    while (current >= 0 && current <= 32) { current = next_byte(); }
    return (u8)(current - 48);
}

func main() -> u64 {
    var rows: u64 = (u64)next_i64();
    var columns: u64 = (u64)next_i64();
    var total: u64 = rows * columns;
    var index: u64 = 0;
    while (index < total) {
        grid[index] = next_grid_cell();
        distances[index] = 0;
        index += 1;
    }

    var head: u64 = 0;
    var tail: u64 = 1;
    queue[0] = 0;
    distances[0] = 1;
    while (head < tail) {
        var position: u64 = queue[head];
        head += 1;
        if (position == total - 1) {
            print_u64(distances[position]);
            print_nl();
            return 0;
        }

        var row: u64 = position / columns;
        var column: u64 = position % columns;
        if (row > 0) {
            var above: u64 = position - columns;
            if (grid[above] != 0 && distances[above] == 0) {
                distances[above] = distances[position] + 1;
                queue[tail] = above;
                tail += 1;
            }
        }
        if (row + 1 < rows) {
            var below: u64 = position + columns;
            if (grid[below] != 0 && distances[below] == 0) {
                distances[below] = distances[position] + 1;
                queue[tail] = below;
                tail += 1;
            }
        }
        if (column > 0) {
            var left: u64 = position - 1;
            if (grid[left] != 0 && distances[left] == 0) {
                distances[left] = distances[position] + 1;
                queue[tail] = left;
                tail += 1;
            }
        }
        if (column + 1 < columns) {
            var right: u64 = position + 1;
            if (grid[right] != 0 && distances[right] == 0) {
                distances[right] = distances[position] + 1;
                queue[tail] = right;
                tail += 1;
            }
        }
    }
    return 1;
}
