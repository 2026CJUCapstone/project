import std.io;

var reader_buffer: [4096]u8;
var reader_pos: u64 = 0;
var reader_len: u64 = 0;

func next_byte() -> i64 {
    if (reader_pos >= reader_len) {
        var count: i64 = input_read(&reader_buffer[0], 4096);
        if (count <= 0) { return -1; }
        reader_len = (u64)count;
        reader_pos = 0;
    }
    var value: i64 = (i64)reader_buffer[reader_pos];
    reader_pos += 1;
    return value;
}

func next_i64() -> i64 {
    var current: i64 = next_byte();
    while (current >= 0 && current <= 32) { current = next_byte(); }
    var sign: i64 = 1;
    if (current == 45) {
        sign = -1;
        current = next_byte();
    } else if (current == 43) {
        current = next_byte();
    }
    var value: i64 = 0;
    while (current >= 48 && current <= 57) {
        value = value * 10 + (current - 48);
        current = next_byte();
    }
    return value * sign;
}

func main() -> u64 {
    var cases: i64 = next_i64();
    var case_index: i64 = 0;
    var output_byte: [1]u8;
    while (case_index < cases) {
        var repeats: i64 = next_i64();
        var current: i64 = next_byte();
        while (current >= 0 && current <= 32) { current = next_byte(); }
        while (current > 32) {
            output_byte[0] = (u8)current;
            var repeat_index: i64 = 0;
            while (repeat_index < repeats) {
                print((u64)&output_byte[0], 1);
                repeat_index += 1;
            }
            current = next_byte();
        }
        print_nl();
        case_index += 1;
    }
    return 0;
}
