APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SANDBOX_IMAGE=compiler-sandbox
EXECUTION_TIMEOUT=10
SANDBOX_WORKDIR_ROOT=/tmp/compiler-sandbox
SANDBOX_MEMORY_MB=256
SANDBOX_CPU_LIMIT=1.0
SANDBOX_PIDS_LIMIT=64
SANDBOX_NOFILE_LIMIT=1024
# Additional scheduler ceiling per Docker daemon, not per worker process.
# Examples only: choose from measured host headroom before enabling workloads.
EXECUTION_MEMORY_BUDGET_MB=1024
EXECUTION_CPU_BUDGET_MILLIS=2000
EXECUTION_JOB_OVERHEAD_MB=32
JUDGE_WORKER_CLASS=legacy
# Operator-owned absolute JSON allowlist; empty keeps measured judging disabled.
# Enroll exact image/runtime/toolchain/launcher only after isolated acceptance.
# Mount the same approved registry in APIs (publication/new receipt gate) and workers.
# Registry matching is configuration approval, not a live worker/image health check.
JUDGE_RUNTIME_REGISTRY=
# Shared immutable UTF-8 test corpus quota before compression (16..8192 MiB).
# Upload <=16MiB each, one receiving upload per API process; not a fleet-wide limit.
JUDGE_TEST_DATA_STORE_MAX_MB=512
JUDGE_TEST_DATA_STORE_MAX_OBJECTS=10000
# Required in production. Generate a unique secret; no example value is valid.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/compiler
